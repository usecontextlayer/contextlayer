{
	"$schema": "https://mintlify.com/docs.json",
	"api": {
		"playground": {
			"display": "none"
		}
	},
	"colors": {
		"primary": "#615FFF"
	},
	"contextual": {
		"options": [
			"copy",
			"view",
			"chatgpt",
			"claude",
			"perplexity",
			"mcp",
			"cursor",
			"vscode"
		]
	},
	"description": "The agent-first platform for bespoke software. Build your tools. Get things done. Open source. Self-hostable.",
	"favicon": "/favicon.png",
	"fonts": {
		"family": "Outfit"
	},
	"footer": {
		"links": [
			{
				"header": "Legal",
				"items": [
					{
						"href": "https://www.usecontextlayer.com/privacy",
						"label": "Privacy"
					},
					{
						"href": "https://www.usecontextlayer.com/terms",
						"label": "Terms"
					}
				]
			}
		],
		"socials": {
			"github": "https://github.com/usecontextlayer/contextlayer"
		}
	},
	"logo": {
		"dark": "/logo/dark.svg",
		"light": "/logo/light.svg"
	},
	"name": "ContextLayer",
	"navbar": {
		"links": [
			{
				"href": "https://github.com/usecontextlayer/contextlayer",
				"type": "github"
			}
		],
		"primary": {
			"href": "https://platform.usecontextlayer.com",
			"label": "Start building",
			"type": "button"
		}
	},
	"navigation": {
		"pages": [
			{
				"group": "Getting Started",
				"pages": ["index", "quickstart"]
			},
			{
				"group": "API reference",
				"openapi": "https://platform.usecontextlayer.com/api/openapi.json"
			}
		]
	},
	"seo": {
		"metatags": {
			"canonical": "https://docs.usecontextlayer.com"
		}
	},
	"theme": "almond"
}
