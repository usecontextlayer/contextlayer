{
	"$schema": "https://mintlify.com/docs.json",
	"api": {
		"playground": {
			"display": "none"
		}
	},
	"colors": {
		"primary": "#615FFF"
	},
	"contextual": {
		"options": [
			"copy",
			"view",
			"chatgpt",
			"claude",
			"perplexity",
			"mcp",
			"cursor",
			"vscode"
		]
	},
	"description": "Build bespoke software as slates: apps, agents, and MCP tools in one Git repository. Declare resources and deploy with a Git push.",
	"favicon": "/favicon.png",
	"fonts": {
		"family": "Outfit"
	},
	"footer": {
		"links": [
			{
				"header": "Legal",
				"items": [
					{
						"href": "https://www.usecontextlayer.com/privacy",
						"label": "Privacy"
					},
					{
						"href": "https://www.usecontextlayer.com/terms",
						"label": "Terms"
					}
				]
			}
		],
		"socials": {
			"github": "https://github.com/usecontextlayer/contextlayer"
		}
	},
	"logo": {
		"dark": "/logo/dark.svg",
		"light": "/logo/light.svg"
	},
	"name": "ContextLayer",
	"navbar": {
		"links": [
			{
				"href": "https://github.com/usecontextlayer/contextlayer",
				"type": "github"
			}
		],
		"primary": {
			"href": "https://platform.usecontextlayer.com",
			"label": "Start building",
			"type": "button"
		}
	},
	"navigation": {
		"tabs": [
			{
				"groups": [
					{
						"group": "Getting started",
						"pages": ["index", "installation", "quickstart"]
					},
					{
						"group": "Core concepts",
						"pages": [
							{
								"group": "Slate",
								"pages": [
									"core-concepts/slate/app",
									"core-concepts/slate/agents",
									"core-concepts/slate/mcp"
								],
								"root": "core-concepts/slate"
							},
							"core-concepts/owners-and-viewers",
							"core-concepts/accounts",
							{
								"group": "Resources",
								"pages": [
									"core-concepts/resources/connections-and-assignments",
									"core-concepts/resources/databases",
									"core-concepts/resources/secrets"
								],
								"root": "core-concepts/resources"
							}
						]
					},
					{
						"group": "How-to",
						"pages": [
							"how-to/use-the-platform-api",
							"how-to/build-an-agent",
							"how-to/connect-an-account",
							"how-to/add-a-database",
							"how-to/deploy",
							"how-to/expose-mcp-tools",
							"how-to/use-a-slate"
						]
					},
					{
						"group": "Reference",
						"pages": ["reference/sdk"]
					}
				],
				"tab": "Guides"
			},
			{
				"openapi": "https://platform.usecontextlayer.com/api/openapi.json",
				"tab": "API Reference"
			}
		]
	},
	"seo": {
		"metatags": {
			"canonical": "https://docs.usecontextlayer.com"
		}
	},
	"theme": "mint"
}
