+
+function redactLog(log: CiRunnerLogs['stdout'], sensitiveValues: string[]): CiRunnerLogs['stdout'] {
+  if (typeof log === 'string') return redact(log, sensitiveValues);
+  const values = [...new Set(sensitiveValues.filter(Boolean))].sort((a, b) => b.length - a.length);
+  if (values.length === 0) return log;
+  const longest = Math.max(...values.map(value => value.length));
+  let pending = '';
+  const emit = (final: boolean) => {
+    const end = final ? pending.length : pending.length - longest + 1;
+    let position = 0;
+    let output = '';
+    while (position < end) {
+      const match = values.find(value => pending.startsWith(value, position));
+      if (match) {
+        output += '[REDACTED]';
+        position += match.length;
+      } else {
+        output += pending[position++];
+      }
+    }
+    pending = pending.slice(position);
+    return output;
+  };
+  const decoder = new TextDecoder();
+  return log.pipeThrough(new TransformStream<Uint8Array, string>({
+    transform(chunk, controller) {
+      pending += decoder.decode(chunk, { stream: true });
+      controller.enqueue(emit(false));
+    },
+    flush(controller) {
+      pending += decoder.decode();
+      controller.enqueue(emit(true));
+    },
+  })).pipeThrough(new TextEncoderStream());
+}
