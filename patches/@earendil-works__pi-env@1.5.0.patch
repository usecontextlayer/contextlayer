+async function startNodeProcess(command, token) {
+    const [program, ...args] = command;
+    if (program === undefined)
+        throw new RemoteError({ code: "spawn_error", message: "No daemon command" });
+    const [{ spawn }, { Readable, Writable }] = await Promise.all([import("node:child_process"), import("node:stream")]);
+    const child = spawn(program, [...args, "serve", "--token", token], { stdio: ["pipe", "pipe", "pipe"] });
+    const exited = new Promise((resolve, reject) => {
+        child.once("error", reject);
+        child.once("exit", resolve);
+    });
+    return {
+        stdin: Writable.toWeb(child.stdin),
+        stdout: Readable.toWeb(child.stdout),
+        stderr: Readable.toWeb(child.stderr),
+        exited,
+        close: () => { child.kill(); },
+    };
+}
