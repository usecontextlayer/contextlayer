{
	"extends": ["//"],
	"tasks": {
		"db.codegen": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"db.latest": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"db.manage": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"dev": {
			"dependsOn": ["build"],
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"dev:watch": {
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"test:integration:node": {
			"cache": false,
			"dependsOn": ["build"],
			"passThroughEnv": [
				"CLOUDFLARE_*",
				"BOAT_API_KEY",
				"COMPOSIO_API_KEY",
				"CTX_CUSTOMER_CREDENTIALS_DOPPLER_TOKEN"
			]
		}
	}
}
