{
	"extends": ["//"],
	"tasks": {
		"db.codegen": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"db.latest": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"db.manage": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"dev": {
			"dependsOn": ["build"],
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"dev:watch": {
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"test:integration:basic": {
			"cache": false,
			"dependsOn": ["build", "@usecontextlayer/dispatcher#build"],
			"passThroughEnv": ["CLOUDFLARE_*", "COMPOSIO_API_KEY", "POLAR_*"]
		},
		"test:integration:claude": {
			"cache": false,
			"dependsOn": ["build", "@usecontextlayer/dispatcher#build"],
			"passThroughEnv": ["CLOUDFLARE_*", "COMPOSIO_API_KEY", "POLAR_*"]
		},
		"test:integration:doppler": {
			"cache": false,
			"dependsOn": ["build", "@usecontextlayer/dispatcher#build"],
			"passThroughEnv": ["CLOUDFLARE_*", "COMPOSIO_API_KEY", "POLAR_*"]
		},
		"test:integration:polar": {
			"cache": false,
			"dependsOn": ["build", "@usecontextlayer/dispatcher#build"],
			"passThroughEnv": ["CLOUDFLARE_*", "COMPOSIO_API_KEY", "POLAR_*"]
		},
		"test:integration:sandbox": {
			"cache": false,
			"dependsOn": ["build", "@usecontextlayer/dispatcher#build"],
			"passThroughEnv": ["CLOUDFLARE_*", "COMPOSIO_API_KEY", "POLAR_*"]
		}
	}
}
