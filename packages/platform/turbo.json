{
	"extends": ["//"],
	"tasks": {
		"build": {
			"env": ["CLOUDFLARE_ENV"],
			"outputs": ["build/**"]
		},
		"build:test": {
			"outputs": ["build-test/**"]
		},
		"db.codegen": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"db.latest": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"db.manage": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"dev:watch": {
			"passThroughEnv": ["CLOUDFLARE_*"]
		}
	}
}
