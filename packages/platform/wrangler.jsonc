{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "662809b9404bec57077de451f84b26cb",
	"artifacts": [
		{
			"binding": "ARTIFACTS",
			"namespace": "contextlayer-prod",
			"remote": true
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "build/client",
		"run_worker_first": ["/api/*", "/git/*", "/dashboard/*"]
	},
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat"],
	"containers": [
		{
			"class_name": "SlateAgentJob",
			"images": { "workspace": { "dockerfile": "./Dockerfile" } },
			"scheduling_policy": "durable_object"
		},
		{
			"class_name": "Meridian",
			"image": "./Dockerfile.meridian",
			"instance_type": "lite",
			"max_instances": 1,
			"scheduling_policy": "default"
		}
	],
	"dev": {
		"ip": "127.0.0.1",
		"port": 3010
	},
	"dispatch_namespaces": [
		{
			"binding": "SLATES",
			"namespace": "contextlayer-prod",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "SlateAgent",
				"name": "AGENTS"
			},
			{
				"class_name": "SlateDatabase",
				"name": "DATABASES"
			},
			{
				"class_name": "SlateAgentJob",
				"name": "AGENT_JOBS"
			},
			{
				"class_name": "Meridian",
				"name": "MERIDIAN"
			}
		]
	},
	"env": {
		"test": {
			"artifacts": [
				{
					"binding": "ARTIFACTS",
					"namespace": "contextlayer-test",
					"remote": true
				}
			],
			"containers": [
				{
					"class_name": "SlateAgentJob",
					"images": { "workspace": { "dockerfile": "./Dockerfile" } },
					"scheduling_policy": "durable_object"
				},
				{
					"class_name": "Meridian",
					"image": "./Dockerfile.meridian",
					"instance_type": "lite",
					"max_instances": 1,
					"scheduling_policy": "default"
				}
			],
			"dispatch_namespaces": [
				{
					"binding": "SLATES",
					"namespace": "contextlayer-test",
					"remote": true
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"class_name": "SlateAgent",
						"name": "AGENTS"
					},
					{
						"class_name": "SlateDatabase",
						"name": "DATABASES"
					},
					{
						"class_name": "SlateAgentJob",
						"name": "AGENT_JOBS"
					},
					{
						"class_name": "Meridian",
						"name": "MERIDIAN"
					}
				]
			},
			"main": "build/server/index.js",
			"routes": [],
			"secrets": {
				"required": [
					"CTX_APP_OAUTH_PROVISIONING_SECRET",
					"CTX_PLATFORM_DATABASE_URL",
					"CTX_AUTH_ISSUER",
					"CTX_OWNER_CREDENTIALS_DOPPLER_PROJECT",
					"CTX_OWNER_CREDENTIALS_DOPPLER_CONFIG",
					"CTX_OWNER_CREDENTIALS_DOPPLER_TOKEN",
					"COMPOSIO_API_KEY",
					"POLAR_WEBHOOK_SECRET",
					"POLAR_ACCESS_TOKEN",
					"POLAR_ENVIRONMENT",
					"POLAR_FREE_PRODUCT_ID",
					"POLAR_CLIPS_METER_ID"
				]
			}
		}
	},
	"main": "app/server.ts",
	"migrations": [
		{
			"new_sqlite_classes": ["SlateAgent"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["SlateDatabase"],
			"tag": "v2"
		},
		{
			"new_sqlite_classes": ["SlateAgentJob"],
			"tag": "v3"
		},
		{
			"new_sqlite_classes": ["Meridian"],
			"tag": "v4"
		}
	],
	"name": "contextlayer-platform",
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"custom_domain": true,
			"pattern": "platform.usecontextlayer.com"
		}
	],
	"secrets": {
		"required": [
			"CTX_APP_OAUTH_PROVISIONING_SECRET",
			"CTX_PLATFORM_DATABASE_URL",
			"CTX_AUTH_ISSUER",
			"CTX_OWNER_CREDENTIALS_DOPPLER_PROJECT",
			"CTX_OWNER_CREDENTIALS_DOPPLER_CONFIG",
			"CTX_OWNER_CREDENTIALS_DOPPLER_TOKEN",
			"COMPOSIO_API_KEY",
			"POLAR_WEBHOOK_SECRET",
			"POLAR_ACCESS_TOKEN",
			"POLAR_ENVIRONMENT",
			"POLAR_FREE_PRODUCT_ID",
			"POLAR_CLIPS_METER_ID"
		]
	}
}
