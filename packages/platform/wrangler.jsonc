{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "662809b9404bec57077de451f84b26cb",
	"artifacts": [
		{
			"binding": "ARTIFACTS",
			"namespace": "contextlayer-dev",
			"remote": true
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "build/client",
		"run_worker_first": ["/api/*", "/git/*", "/dashboard/*"]
	},
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "app/server.ts",
	"name": "contextlayer-platform",
	"routes": [
		{
			"custom_domain": true,
			"pattern": "slate.usecontextlayer.com"
		}
	],
	"secrets": {
		"required": [
			"CTX_PLATFORM_DATABASE_URL",
			"CTX_AUTH_ISSUER",
			"CTX_CUSTOMER_CREDENTIALS_DOPPLER_PROJECT",
			"CTX_CUSTOMER_CREDENTIALS_DOPPLER_CONFIG",
			"CTX_CUSTOMER_CREDENTIALS_DOPPLER_TOKEN",
			"COMPOSIO_API_KEY",
			"POLAR_WEBHOOK_SECRET",
			"POLAR_ACCESS_TOKEN",
			"POLAR_ENVIRONMENT"
		]
	}
}
