		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "dist-types",
		"paths": {
			"@/*": ["./*"]
		},
		"types": ["node", "@cloudflare/workers-types"]
	},
	"exclude": ["dist", "templates", "dist-types", "vitest.config.ts"],
