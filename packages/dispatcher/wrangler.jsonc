{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "662809b9404bec57077de451f84b26cb",
	"compatibility_date": "2026-10-02",
	"dispatch_namespaces": [
		{
			"binding": "SLATES",
			"namespace": "contextlayer-prod",
			"remote": true
		}
	],
	"env": {
		"test": {
			"dispatch_namespaces": [
				{
					"binding": "SLATES",
					"namespace": "contextlayer-test",
					"remote": true
				}
			],
			"routes": [],
			"secrets": {
				"required": [
					"CTX_PLATFORM_URL",
					"CTX_VIEWER_AUTH_URL",
					"POLAR_ACCESS_TOKEN",
					"POLAR_ENVIRONMENT"
				]
			},
			"services": [
				{
					"binding": "EXECUTION",
					"entrypoint": "Execution",
					"service": "contextlayer-platform-test"
				}
			],
			"vars": {}
		}
	},
	"main": "index.ts",
	"name": "contextlayer-dispatcher",
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "*.contextlayer.xyz/*",
			"zone_id": "05346f30e7de4d8f63fe8889156a7f73"
		}
	],
	"secrets": {
		"required": ["POLAR_ACCESS_TOKEN", "POLAR_ENVIRONMENT"]
	},
	"services": [
		{
			"binding": "EXECUTION",
			"entrypoint": "Execution",
			"service": "contextlayer-platform"
		}
	],
	"vars": {
		"CTX_PLATFORM_URL": "https://platform.usecontextlayer.com"
	},
	"workers_dev": false
}
