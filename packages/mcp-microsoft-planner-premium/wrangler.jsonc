{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "662809b9404bec57077de451f84b26cb",
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "index.ts",
	"name": "contextlayer-mcp-microsoft-planner-premium",
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"custom_domain": true,
			"pattern": "microsoft-planner-premium.mcp.usecontextlayer.com"
		}
	],
	"secrets": {
		"required": ["MICROSOFT_CLIENT_ID", "MICROSOFT_CLIENT_SECRET"]
	}
}
