{
	"compilerOptions": {
		"composite": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "dist-types",
		"paths": {
			"@/*": ["./*"]
		},
		"types": ["@cloudflare/workers-types", "node", "vite/client"]
	},
	"exclude": ["dist", "dist-types"],
	"extends": "../../tsconfig.base.json",
	"include": ["*.ts", "*.tsx", "components/**/*.tsx", "package.json"],
	"references": [
		{
			"path": "../cli"
		},
		{
			"path": "../shared"
		}
	]
}
