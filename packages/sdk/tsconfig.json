{
	"compilerOptions": {
		"composite": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "dist-types",
		"paths": {
			"@/*": ["./*"]
		},
		"types": ["@cloudflare/workers-types", "node", "vite/client"]
	},
	"exclude": ["dist", "dist-types", "vitest.config.ts"],
	"extends": "../../tsconfig.base.json",
	"include": [
		"*.ts",
		"*.tsx",
		"__tests__/**/*.ts",
		"components/**/*.tsx",
		"package.json"
	],
	"references": [
		{
			"path": "../cli"
		},
		{
			"path": "../shared"
		}
	]
}
