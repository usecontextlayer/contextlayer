{
	"$schema": "https://turbo.build/schema.json",
	// Pass runtime configuration through without adding it to cache keys.
	// TMPDIR preserves the caller's temporary-directory location; INIT_CWD
	// preserves the directory pnpm was invoked from.
	"globalPassThroughEnv": [
		"CTX*",
		"TWILIO*",
		"COMPOSIO_API_KEY",
		"POLAR_*",
		"BETTER_AUTH_URL",
		"DATABASE_URL",
		"TMPDIR",
		"INIT_CWD"
	],
	"tasks": {
		"@usecontextlayer/cli#test": {
			"dependsOn": ["build"]
		},
		"@usecontextlayer/platform#build:test:computer": {
			"dependsOn": ["^build"],
			"outputs": ["dist/computer/**"],
			"passThroughEnv": ["WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST"]
		},
		"//#format.verify": {
			"cache": false
		},
		"//#test:gen-slate-project": {
			"dependsOn": [
				"@usecontextlayer/cli#build",
				"@usecontextlayer/dev-env#build",
				"@usecontextlayer/sdk#build"
			],
			"inputs": ["scripts/gen-slate-project.ts"],
			"outputs": ["artifacts/slate-project/**"]
		},
		"//#tsc.scripts": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "bin/**", "build/**", ".vercel/**"],
			"passThroughEnv": ["WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST"]
		},
		"build:test": {
			"dependsOn": ["^build"],
			"outputs": ["dist-test/**"],
			"passThroughEnv": ["WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST"]
		},
		"clean": {
			"cache": false
		},
		"db.latest": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		},
		"dev:watch": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		},
		"fuzz": {
			"cache": false,
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:integration:basic": {
			"cache": false,
			"dependsOn": [
				"//#test:gen-slate-project",
				"^build",
				"@usecontextlayer/platform#build:test",
				"@usecontextlayer/build#build:test",
				"@usecontextlayer/dispatcher#build:test",
				"@usecontextlayer/platform#build:test:computer"
			],
			"outputs": []
		},
		"test:integration:browser": {
			"cache": false,
			"dependsOn": [
				"//#test:gen-slate-project",
				"^build",
				"@usecontextlayer/platform#build:test",
				"@usecontextlayer/build#build:test",
				"@usecontextlayer/dispatcher#build:test",
				"@usecontextlayer/platform#build:test:computer"
			],
			"outputs": []
		},
		"test:integration:doppler": {
			"cache": false,
			"dependsOn": [
				"//#test:gen-slate-project",
				"^build",
				"@usecontextlayer/platform#build:test",
				"@usecontextlayer/build#build:test",
				"@usecontextlayer/dispatcher#build:test",
				"@usecontextlayer/platform#build:test:computer"
			],
			"outputs": [],
			"passThroughEnv": ["CLOUDFLARE_*", "!CLOUDFLARE_ENV", "COMPOSIO_API_KEY", "POLAR_*"]
		},
		"test:integration:polar": {
			"cache": false,
			"dependsOn": [
				"//#test:gen-slate-project",
				"^build",
				"@usecontextlayer/platform#build:test",
				"@usecontextlayer/build#build:test",
				"@usecontextlayer/dispatcher#build:test",
				"@usecontextlayer/platform#build:test:computer"
			],
			"outputs": []
		},
		"test:integration:polar-webhooks": {
			"cache": false,
			"dependsOn": [
				"//#test:gen-slate-project",
				"^build",
				"@usecontextlayer/platform#build:test",
				"@usecontextlayer/build#build:test",
				"@usecontextlayer/dispatcher#build:test",
				"@usecontextlayer/platform#build:test:computer"
			],
			"outputs": []
		},
		"test:integration:remote": {
			"cache": false,
			"dependsOn": [
				"//#test:gen-slate-project",
				"^build",
				"@usecontextlayer/platform#build:test",
				"@usecontextlayer/build#build:test",
				"@usecontextlayer/dispatcher#build:test",
				"@usecontextlayer/platform#build:test:computer"
			],
			"outputs": [],
			"passThroughEnv": [
				"CLAUDE_CODE_OAUTH_TOKEN",
				"CLOUDFLARE_*",
				"!CLOUDFLARE_ENV",
				"COMPOSIO_API_KEY",
				"POLAR_*"
			]
		},
		"tsc": {
			"dependsOn": ["^build", "^tsc"],
			"outputs": []
		}
	}
}
