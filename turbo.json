{
	"$schema": "https://turbo.build/schema.json",
	// Pass runtime configuration through without adding it to cache keys.
	// TMPDIR preserves the caller's temporary-directory location; INIT_CWD
	// preserves the directory pnpm was invoked from.
	"globalPassThroughEnv": [
		"CTX*",
		"TWILIO*",
		"COMPOSIO_API_KEY",
		"POLAR_*",
		"BETTER_AUTH_URL",
		"DATABASE_URL",
		"TMPDIR",
		"INIT_CWD"
	],
	"tasks": {
		"@usecontextlayer/cli#test": {
			"dependsOn": ["build"]
		},
		"//#format.verify": {
			"cache": false
		},
		"//#tsc.scripts": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "bin/**", "build/**", ".vercel/**"],
			"passThroughEnv": ["WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST"]
		},
		"clean": {
			"cache": false
		},
		"db.latest": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		},
		"dev:watch": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		},
		"fuzz": {
			"cache": false,
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:integration:browser": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:integration:claude": {
			"cache": false,
			"dependsOn": ["build"],
			"outputs": [],
			// Real Claude integration tests receive their runtime OAuth credential
			// without adding it to cache keys.
			"passThroughEnv": ["CLAUDE_CODE_OAUTH_TOKEN"]
		},
		"test:integration:node": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": []
		},
		"tsc": {
			"dependsOn": ["^build", "^tsc"],
			"outputs": []
		}
	}
}
