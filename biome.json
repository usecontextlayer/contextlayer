{
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedKeys": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/dist",
			"!!**/.turbo",
			"!!.agents/skills",
			"!!**/.next",
			"!!**/_build",
			"!!**/deps",
			"!!**/prior_art",
			"!!**/priv/static",
			"!!**/package-lock.json",
			"!!**/worker-configuration.d.ts",
			"!!**/plugin-registry.json",
			"!!**/*.md"
		]
	},
	"formatter": {
		"attributePosition": "multiline",
		"enabled": true,
		"formatWithErrors": true,
		"lineEnding": "auto",
		"lineWidth": 90,
		"useEditorconfig": true
	},
	"html": {
		"formatter": {
			"indentScriptAndStyle": true
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"quoteStyle": "double",
			"semicolons": "asNeeded",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useValidAnchor": "off"
			},
			"correctness": {
				"noUnknownProperty": "off"
			},
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "warn",
					"options": {
						"patterns": [
							{
								"group": ["./**", "../**", ".", ".."],
								"message": "Relative imports are disallowed; use the \"@/\" path alias for internal modules."
							}
						]
					}
				},
				"useConst": "error",
				"useImportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noUnknownAtRules": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/components/ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useKeyWithClickEvents": "off",
						"useSemanticElements": "off"
					}
				}
			}
		},
		{
			"includes": ["**/database/models/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
